rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ДЕМО-ПРАВИЛА. Не использовать для реального публичного магазина.
    // Они разрешают чтение и запись коллекции settings всем посетителям сайта.
    match /settings/{document} {
      allow read, write: if true;
    }
  }
}
